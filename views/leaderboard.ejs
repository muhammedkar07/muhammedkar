<!doctype html><html lang="tr"><head><meta charset="utf-8"><title>Sıralama</title><link rel="stylesheet" href="/style.css"></head><body><main class="wide"><div class="head"><h1>Sınav Sıralaması</h1><a href="<%=typeof hasResult!=='undefined'&&hasResult?'/result':'/'%>"><%=typeof hasResult!=='undefined'&&hasResult?'Sonuç sayfasına geri dön':'Sınava dön'%></a></div><% if(currentRank){%><section class="my-rank" aria-label="Kendi sıralamanız"><div><span>Kendi sıralamanız</span><strong>#<%=currentRank%></strong></div><div><span>Puanınız</span><strong><%=rows[currentRank-1].score%></strong></div><a href="#my-result">Listede beni göster ↓</a></section><%}%><div class="table-wrap"><table><thead><tr><th>#</th><th>Ad Soyad</th><th>Puan</th><th>Doğru</th><th>Yanlış</th><th>Boş</th><th>Süre</th></tr></thead><tbody><% rows.forEach((r,i)=>{%><tr id="<%=r.isCurrent?'my-result':''%>" class="<%=r.isCurrent?'current-result':''%>"><td><%=i+1%><% if(r.isCurrent){%> <span class="you-badge">Siz</span><%}%></td><td><%=r.displayName%></td><td><b><%=r.score%></b></td><td><%=r.correct%></td><td><%=r.wrong%></td><td><%=r.blank%></td><td><%=Math.floor(r.duration/60)%>:<%=String(r.duration%60).padStart(2,'0')%></td></tr><%})%></tbody></table></div><% if(currentRank){%><script>document.getElementById('my-result')?.scrollIntoView({block:'center'});</script><%}%></main></body></html>
