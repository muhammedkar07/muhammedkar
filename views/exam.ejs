<!doctype html><html lang="tr"><head><meta charset="utf-8"><title>jspsplus Deneme Sınavı</title><link rel="stylesheet" href="/style.css"></head><body><header class="top"><b>jspsplus</b><span><%=name%></span></header><main class="exam"><form id="exam" method="post" action="/submit"><div class="progress"><span id="counter">1 / 100</span><span id="timer" data-remaining-seconds="<%=remainingSeconds%>" aria-live="polite">120:00</span></div><% questions.forEach((q,i)=>{ %><section class="question" data-index="<%=i%>"><h2><%=i+1%>. <%=q.question%></h2><% ['A','B','C','D','E'].forEach(x=>{let k=x.toLowerCase();%><label class="option"><input type="radio" name="answers[q<%=q.id%>]" value="<%=x%>" <%=answers[q.id]===x?'checked':''%>><b><%=x%>)</b> <%=q[k]%></label><%})%></section><%})%><div class="nav"><button type="button" id="prev">Önceki</button><button type="button" id="next">Sonraki</button><button type="submit" id="finish">Sınavı Bitir</button></div></form></main><script src="/exam.js"></script></body></html>
