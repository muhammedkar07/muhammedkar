<!doctype html><html lang="tr"><head><meta charset="utf-8"><title>Yönetici Paneli</title><link rel="stylesheet" href="/style.css"></head><body><main class="wide"><div class="head"><h1>Yönetici Paneli</h1><form method="post" action="/admin/logout"><button>Çıkış</button></form></div>
<% const params={error:null,success:null}; %><% if(typeof error!=='undefined'&&error){%><div class="err"><%=error%></div><%}%><% if(typeof success!=='undefined'&&success){%><div class="ok"><%=success%></div><%}%>
<h2 id="results">Sonuçlar</h2><p><a class="button" href="/admin/export-results">Sonuçları Excel'e Aktar</a></p><div class="table-wrap"><table><thead><tr><th>#</th><th>Ad Soyad</th><th>E-posta</th><th>Puan</th><th>D/Y/B</th><th>Süre</th><th>Tarih</th><th>İşlem</th></tr></thead><tbody><%rows.forEach((r,i)=>{%><tr><td><%=i+1%></td><td><%=r.name%></td><td><%=r.email||r.participant_no%></td><td><%=r.score%></td><td><%=r.correct%>/<%=r.wrong%>/<%=r.blank%></td><td><%=Math.floor(r.duration/60)%>:<%=String(r.duration%60).padStart(2,'0')%></td><td><%=r.created_at%></td><td><form method="post" action="/admin/result/<%=r.id%>/delete" onsubmit="return confirm('<%=r.name%> adlı katılımcının sonucunu silmek ve bu e-posta ile yeniden sınava girmesine izin vermek istiyor musunuz?')"><button class="delete-result">Sonucu Sil</button></form></td></tr><%})%></tbody></table></div><form method="post" action="/admin/reset-results" onsubmit="return confirm('Tüm sonuçlar silinsin mi?')"><button class="danger">Tüm Sonuçları Sil</button></form>
<h2 id="questions">100 Soruyu Excel'den Tek Seferde Yükle</h2><p>Şablonu indir, 100 soruyu doldur ve tek seferde aktar. Sütunlar: <b>Soru, A, B, C, D, E, DogruCevap</b>. DogruCevap yalnızca A/B/C/D/E olabilir.</p><p><a class="button secondary" href="/admin/questions-template">100 Soruluk Excel Şablonunu İndir</a></p><form method="post" action="/admin/import-questions" enctype="multipart/form-data"><input type="file" name="excel" accept=".xlsx,.xls" required><button>100 Soruyu Aktar</button></form>
<h2>Tek Tek Düzenleme</h2><%questions.forEach(q=>{%><form class="qedit" method="post" action="/admin/question/<%=q.id%>"><h3><%=q.id%>. Soru</h3><textarea name="question" required><%=q.question%></textarea><div class="grid"><input name="a" value="<%=q.a%>" required><input name="b" value="<%=q.b%>" required><input name="c" value="<%=q.c%>" required><input name="d" value="<%=q.d%>" required><input name="e" value="<%=q.e%>" required><select name="answer"><%['A','B','C','D','E'].forEach(x=>{%><option <%=q.answer===x?'selected':''%>><%=x%></option><%})%></select></div><button>Kaydet</button></form><%})%></main></body></html>
